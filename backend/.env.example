# Copia este archivo como .env y completa los valores. El .env NUNCA se sube al repo.

# ── Servidor ─────────────────────────────────────────────
PORT=3000

# ── Base de datos (MongoDB Atlas) ────────────────────────
# mongodb+srv://<usuario>:<contraseña>@<cluster>/supportdesk?appName=<app>
MONGODB_URI=

# ── Autenticación ────────────────────────────────────────
# Cadena larga y aleatoria. Genérala con: openssl rand -hex 32
JWT_SECRET=
# Opcional: vida del access token en segundos (por defecto 900 = 15 min). Bájalo (ej. 30) para probar la renovación
ACCESS_TOKEN_SEGUNDOS=
# Cookie de sesión (refresh token, 7 días). Local: lax. Producción con frontend y API en dominios distintos: none (exige HTTPS)
COOKIE_SAMESITE=lax
# Opcional: true para forzar Secure (en producción y con SameSite=none ya se activa solo)
COOKIE_SECURE=

# ── Adjuntos (S3 o Cloudflare R2) ────────────────────────
# Sin estas 3 + el bucket, los tickets funcionan pero no se pueden subir archivos.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
# Región del bucket en S3 (ej. us-east-1). En R2: auto
STORAGE_REGION=us-east-1
# Solo R2: https://<account_id>.r2.cloudflarestorage.com (en S3 se deja vacío)
STORAGE_ENDPOINT=
# Opcional: carpeta propia dentro de un bucket compartido
STORAGE_PREFIX=supportdesk/

# ── Notificaciones por email ─────────────────────────────
# "consola" imprime los emails en esta terminal en vez de enviarlos (desarrollo)
EMAIL_PROVEEDOR=consola
EMAIL_REMITENTE=SupportDesk <no-reply@localhost>
# Origen(es) del frontend, separados por coma: CORS con credenciales y enlaces "Ver ticket" de los emails.
# Debe coincidir exactamente con la URL donde abres el frontend (localhost ≠ 127.0.0.1)
FRONTEND_URL=http://localhost:5173
